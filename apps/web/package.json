{
  "name": "@magyarsportonline/web",
  "private": true,
  "version": "0.0.0",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "db:migrate": "pnpm --filter @magyarsportonline/db db:migrate",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@magyarsportonline/agents": "workspace:*",
    "@magyarsportonline/db": "workspace:*",
    "@magyarsportonline/events": "workspace:*",
    "@magyarsportonline/llm": "workspace:*",
    "@magyarsportonline/observability": "workspace:*",
    "@magyarsportonline/shared": "workspace:*",
    "@opennextjs/cloudflare": "1.20.6",
    "@t3-oss/env-nextjs": "0.11.1",
    "next": "15.5.24",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@magyarsportonline/config": "workspace:*",
    "@types/node": "22.10.5",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "eslint": "9.18.0",
    "typescript": "5.9.3",
    "vitest": "2.1.8",
    "wrangler": "4.127.1"
  }
}
