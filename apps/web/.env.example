# Másold `.env.local` néven és töltsd ki. A `.env.local` sosem kerül git alá
# (lásd .gitignore) — soha ne commitolj valódi secretet ebbe a fájlba vagy
# bármelyik másikba. Éles/staging/preview környezetben ugyanezek a
# változók Vercel Environment Variables-ként vannak beállítva,
# környezetenként külön értékkel (docs/architecture/06-deployment.md §6.6).
#
# A validáció forrása: apps/web/lib/env.ts — ha egy változó hiányzik vagy
# rossz formátumú, az app boot-kor (nem egy véletlen request közepén) fog
# hibázni.

# --- Kötelező: packages/db kliens (lib/db.ts) ---
# Postgres connection string (Neon/Supabase).
DATABASE_URL=

# --- LLM adapter kiválasztása (packages/llm) ---
# none (alapértelmezés): determinisztikus NoLlmClient — nincs API-hívás,
#   nincs költség, semmilyen API-kulcs nem szükséges. A Fact Verification /
#   Hungarian Writer agentek az eredeti cím + RSS-leírás nyers szövegét
#   adják tovább, egyértelműen "nem AI-fordított" jelöléssel
#   (lásd docs/infrastructure-setup.md).
# gemini: valódi, ingyenes tierű Google Gemini API-hívás — ekkor
#   GEMINI_API_KEY kötelező. Kvóta-/403-/szolgáltatáshiba esetén a
#   ProviderFallbackLlmClient automatikusan No-LLM módra vált, a pipeline
#   nem áll le (packages/llm/src/provider-fallback-client.ts).
# anthropic: valódi, fizetős Anthropic API-hívás — ekkor ANTHROPIC_API_KEY
#   kötelező. Egyelőre nem használjuk (ld. Gemini free-tier teszt).
LLM_PROVIDER=none

# --- Csak LLM_PROVIDER=gemini esetén kötelező ---
# Ingyenes tier — Google AI Studio-ban (aistudio.google.com/apikey)
# generálható, nem igényel fizetős Google Cloud billinget.
GEMINI_API_KEY=

# --- Csak LLM_PROVIDER=gemini esetén, opcionális ---
# Ingyenes tierben elérhető, stabil Flash-Lite modell alapértelmezésben
# (packages/llm/src/gemini-client.ts) — kód nélkül felülírható, ha Google
# időközben megváltoztatja a free-tier kínálatot.
GEMINI_MODEL=gemini-2.0-flash-lite

# --- Csak LLM_PROVIDER=anthropic esetén kötelező ---
ANTHROPIC_API_KEY=

# --- Kötelező: /api/internal/cron/dispatch-ingest védelme ---
# Vercel Cron automatikusan "Authorization: Bearer $CRON_SECRET" fejléccel hívja,
# ha ez a változó be van állítva a projekt Vercel környezetében.
CRON_SECRET=

# --- Fázis 2+ (a jelenlegi in-process dispatcher helyett valódi Inngest-kötés) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Fázis 11+ (Social Media Agent) ---
META_GRAPH_API_TOKEN=
X_API_BEARER_TOKEN=

# --- Fázis 10+ (Admin Review UI hitelesítés, NextAuth) ---
NEXTAUTH_SECRET=

# --- Elérhető Fázis 0-tól ---
# trace | debug | info | warn | error | fatal — alapértelmezés: info
LOG_LEVEL=info

# --- Havi LLM költségplafon USD-ben (alapértelmezés: 5) ---
# Elérésekor a rendszer automatikusan No-LLM módra vált, nem áll le
# (packages/llm/src/budget-guard.ts, llm_usage tábla).
LLM_MONTHLY_BUDGET_USD=5

# --- Admin/review felület (/admin/review) ---
# HTTP Basic auth jelszó ("admin" felhasználónévvel). Ha üres, az admin
# felület 503-mal le van tiltva. Generálás: openssl rand -hex 16
ADMIN_SECRET=

# --- A publikus site kanonikus origin-je (SEO: canonical, sitemap, RSS, JSON-LD) ---
# Alapértelmezés: https://magyarsportonline-web.vercel.app
SITE_URL=
