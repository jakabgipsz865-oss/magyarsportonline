# Másold `.env.local` néven és töltsd ki. A `.env.local` sosem kerül git alá
# (lásd .gitignore) — soha ne commitolj valódi secretet ebbe a fájlba vagy
# bármelyik másikba. Éles/staging/preview környezetben ugyanezek a
# változók Cloudflare Worker secretekként vagy vars értékekként vannak beállítva,
# környezetenként külön értékkel (docs/architecture/06-deployment.md §6.6).
#
# A validáció forrása: apps/web/lib/env.ts — ha egy változó hiányzik vagy
# rossz formátumú, az app boot-kor (nem egy véletlen request közepén) fog
# hibázni.

# --- Helyi futtatásnál kötelező: packages/db kliens (lib/db.ts) ---
# Postgres connection string (Neon/Supabase). A Workerben a HYPERDRIVE binding helyettesíti.
DATABASE_URL=

# --- Production Fact Extraction + Self Check: Cloudflare Workers AI ---
# A "none" érték csak explicit helyi fejlesztéshez/teszthez használható.
# Productionben bármilyen Cloudflare-hiba fail-closed: a job várakozik,
# sosem készül No-LLM vagy más providerből származó cikk.
LLM_PROVIDER=cloudflare

# --- Csak LLM_PROVIDER=cloudflare esetén kötelező ---
# Cloudflare Dashboard (jobb felső sáv) → Account ID.
CLOUDFLARE_ACCOUNT_ID=
# "Workers AI" jogosultságú API-token: Cloudflare Dashboard → My Profile →
# API Tokens → Create Token. Kvótahiánynál a pipeline deferel; paid fallback nincs.
WORKERS_AI_API_TOKEN=

# --- Csak LLM_PROVIDER=cloudflare esetén, opcionális ---
# Cloudflare JSON Mode-ot támogató, production alapmodell.
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# --- Final Hungarian Writer: Gemini a Cloudflare AI Gatewayen keresztül ---
# Mindkét kulcs kizárólag szerveroldali Worker secret. Fizetős fallback nincs.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FREE_ONLY=true
# Alkalmazásoldali napi hard cap.
GEMINI_DAILY_REQUEST_CAP=450
GEMINI_BASE_URL=https://gateway.ai.cloudflare.com/v1/7a225d650d7e05daba6355e5526a8fb9/magyarsportonline/google-ai-studio/v1
CLOUDFLARE_AI_GATEWAY_TOKEN=

# --- Kötelező: /api/internal/cron/dispatch-ingest védelme ---
# A külön scheduler Worker ezzel a Bearer tokennel hívja a belső végpontokat.
CRON_SECRET=

# --- Fázis 2+ (a jelenlegi in-process dispatcher helyett valódi Inngest-kötés) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Automatikus Facebook Page publikálás ---
# Maradjon false, amíg nincs érvényes Page Access Token.
FACEBOOK_AUTO_PUBLISH=false
FACEBOOK_AUTO_PUBLISH_START_AT=2026-09-15T20:30:00.000Z
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v26.0

# --- Fázis 11+ (további social csatornák) ---
X_API_BEARER_TOKEN=

# --- Fázis 10+ (Admin Review UI hitelesítés, NextAuth) ---
NEXTAUTH_SECRET=

# --- Elérhető Fázis 0-tól ---
# trace | debug | info | warn | error | fatal — alapértelmezés: info
LOG_LEVEL=info

# --- Admin/review felület (/admin/review) ---
# HTTP Basic auth jelszó ("admin" felhasználónévvel). Ha üres, az admin
# felület 503-mal le van tiltva. Generálás: openssl rand -hex 16
ADMIN_SECRET=

# --- A publikus site kanonikus origin-je (SEO: canonical, sitemap, RSS, JSON-LD) ---
# Alapértelmezés: https://magyarsportonline.hu
SITE_URL=

# P0 v2 public clean slate: keep disabled until the 0-LLM RSS review is approved.
TABLOID_AUTO_PUBLISH=false
