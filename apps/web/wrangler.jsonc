{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "magyarsportonline-web",
  "main": ".open-next/worker.js",
  "workers_dev": true,
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "mso-remediation-staging-20260928",
    "database_id": "eb02f98e-fd89-4277-94be-0f763056b91e"
  }],
  "routes": [
    {
      "pattern": "mso24.hu",
      "custom_domain": true,
    },
    {
      "pattern": "magyarsportonline.hu",
      "custom_domain": true,
    },
    {
      "pattern": "www.magyarsportonline.hu",
      "custom_domain": true,
    },
  ],
  "vars": {
    "SITE_URL": "https://mso24.hu",
    "LLM_PROVIDER": "cloudflare",
    "CLOUDFLARE_ACCOUNT_ID": "7a225d650d7e05daba6355e5526a8fb9",
    "CLOUDFLARE_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    "GEMINI_BILLING_MODE": "unified",
    "GEMINI_FREE_ONLY": "false",
    "GEMINI_DAILY_REQUEST_CAP": "450",
    "GEMINI_MONTHLY_BUDGET_USD": "9.5",
    "GEMINI_MONTHLY_EXTERNAL_SPEND_USD": "1.00",
    "GEMINI_BASE_URL": "https://gateway.ai.cloudflare.com/v1/7a225d650d7e05daba6355e5526a8fb9/magyarsportonline/google-ai-studio/v1",
    "CLOUDFLARE_AI_GATEWAY_ID": "magyarsportonline",
    "TABLOID_AUTO_PUBLISH": "true",
    "FORCE_REVIEW_MODE": "false",
    "FACEBOOK_AUTO_PUBLISH": "true",
    "D1_PIPELINE_START_AT": "2026-09-28T17:30:00.000Z",
    "FACEBOOK_AUTO_PUBLISH_START_AT": "2026-09-28T17:30:00.000Z",
    "META_GRAPH_API_VERSION": "v26.0",
  },
  "queues": {
    "producers": [
      {
        "binding": "FACEBOOK_QUEUE",
        "queue": "mso-facebook-publish",
      },
    ],
  },
  "observability": {
    "enabled": true,
  },
}
