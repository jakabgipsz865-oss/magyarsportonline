{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "magyarsportonline-web",
  "main": ".open-next/worker.js",
  "workers_dev": true,
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "3a2967f028b449f7ade610395f6ccfbe",
    },
  ],
  "routes": [
    {
      "pattern": "magyarsportonline.hu",
      "custom_domain": true,
    },
    {
      "pattern": "www.magyarsportonline.hu",
      "custom_domain": true,
    },
  ],
  "vars": {
    "SITE_URL": "https://magyarsportonline.hu",
    "LLM_PROVIDER": "cloudflare",
    "CLOUDFLARE_ACCOUNT_ID": "7a225d650d7e05daba6355e5526a8fb9",
    "CLOUDFLARE_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "GEMINI_MODEL": "gemini-3.5-flash",
    "GEMINI_BILLING_MODE": "unified",
    "GEMINI_FREE_ONLY": "false",
    "GEMINI_DAILY_REQUEST_CAP": "450",
    "GEMINI_MONTHLY_BUDGET_USD": "5",
    "GEMINI_BASE_URL": "https://gateway.ai.cloudflare.com/v1/7a225d650d7e05daba6355e5526a8fb9/magyarsportonline/google-ai-studio/v1",
    "TABLOID_AUTO_PUBLISH": "true",
    "FORCE_REVIEW_MODE": "true",
  },
  "observability": {
    "enabled": true,
  },
}
