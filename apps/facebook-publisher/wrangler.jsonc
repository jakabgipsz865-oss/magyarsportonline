{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "magyarsportonline-facebook-publisher",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "d1_databases": [{
    "binding": "DB",
    "database_name": "mso-remediation-staging-20260928",
    "database_id": "eb02f98e-fd89-4277-94be-0f763056b91e"
  }],
  "vars": {
    "META_GRAPH_API_VERSION": "v26.0",
    "PUBLIC_SITE_ORIGIN": "https://mso24.hu",
    "FACEBOOK_AUTO_PUBLISH_START_AT": "2026-09-28T17:30:00.000Z",
  },
  "queues": {
    "consumers": [
      {
        "queue": "mso-facebook-publish",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "retry_delay": 60,
        "dead_letter_queue": "mso-facebook-publish-dlq",
        "max_concurrency": 1,
      },
    ],
  },
  "observability": {
    "enabled": true,
  },
}
