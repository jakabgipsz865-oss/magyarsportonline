{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      // Turborepo strict env mode forwards only declared variables. The web
      // build can use DATABASE_URL for build-time rendering; deployed
      // Workers use the HYPERDRIVE binding at runtime.
      "env": [
        "DATABASE_URL",
        "LLM_PROVIDER",
        "CLOUDFLARE_ACCOUNT_ID",
        "WORKERS_AI_API_TOKEN",
        "CLOUDFLARE_AI_MODEL",
        "GEMINI_API_KEY",
        "GEMINI_MODEL",
        "GEMINI_FREE_ONLY",
        "GEMINI_DAILY_REQUEST_CAP",
        "GEMINI_BASE_URL",
        "CLOUDFLARE_AI_GATEWAY_TOKEN",
        "CRON_SECRET",
        "SITE_URL"
      ]
    },
    // The web build performs database-backed static generation. Keep it
    // uncached so a deployment cannot replay HTML generated from another
    // environment or an older database snapshot. Migrations are a separate
    // serialized CI step and are never a build side effect.
    "@magyarsportonline/web#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "DATABASE_URL",
        "LLM_PROVIDER",
        "CLOUDFLARE_ACCOUNT_ID",
        "WORKERS_AI_API_TOKEN",
        "CLOUDFLARE_AI_MODEL",
        "GEMINI_API_KEY",
        "GEMINI_MODEL",
        "GEMINI_FREE_ONLY",
        "GEMINI_DAILY_REQUEST_CAP",
        "GEMINI_BASE_URL",
        "CLOUDFLARE_AI_GATEWAY_TOKEN",
        "CRON_SECRET",
        "SITE_URL"
      ],
      "cache": false
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
